# Local development
NODE_ENV=development
RUN_HTTP_SERVER=true
PORT=4000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000

# Google OAuth
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# MongoDB Atlas
MONGODB_USERNAME=YOUR_MONGODB_USERNAME
MONGODB_PASSWORD=YOUR_MONGODB_PASSWORD
MONGODB_URI="YOUR_MONGODB_ATLAS_CONNECTION_STRING"

# Session security
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG

# Application settings
APPLICATION_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info

# Email
EMAIL_PROVIDER=console
EMAIL_FROM="SGGS Leave System <noreply@example.edu>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Private storage
PRIVATE_STORAGE_PROVIDER=disabled
PRIVATE_STORAGE_PATH=./uploads

# Scheduled tasks
CRON_SECRET=GENERATE_A_RANDOM_CRON_SECRET

# One-time admin bootstrap
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
