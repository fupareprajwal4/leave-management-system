# Local development. For Vercel, set these under Project Settings > Environment Variables.
NODE_ENV=development
RUN_HTTP_SERVER=true
PORT=4000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:4000
MONGODB_URI=mongodb://127.0.0.1:27017/sggs_leave
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
APPLICATION_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
EMAIL_PROVIDER=console
EMAIL_FROM=SGGS Leave System <noreply@example.edu>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
PRIVATE_STORAGE_PROVIDER=disabled
PRIVATE_STORAGE_PATH=./uploads
CRON_SECRET=replace-with-a-random-cron-secret

# One-time bootstrap only; do not expose these values to the frontend.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
